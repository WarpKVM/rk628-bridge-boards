# rk628-30p RK628H bridge board: kernel config fragment.
#
# Same shape as Rockchip's own rv1126b-rk628.config. Merge into the board
# defconfig before building, e.g.:
#
#   ./scripts/kconfig/merge_config.sh -m -O . .config rk628h.config
#
# VIDEO_RK628* are tristate, so =m also works if you would rather ship
# modules; =y is used here because the Firefly BSP image does not install a
# module tree or kernel headers by default.

CONFIG_VIDEO_RK628=y
CONFIG_VIDEO_RK628_CSI=y
CONFIG_VIDEO_ROCKCHIP_HDMIRX_CLASS=y
CONFIG_HDMI=y
CONFIG_CEC_CORE=y

# Capture path: rkcif plus its IOMMU.
CONFIG_VIDEO_ROCKCHIP_CIF=y
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y
CONFIG_GENERIC_PHY_MIPI_DPHY=y

# Lets a future revision of this board ship as a .dtbo overlay plus a module
# instead of a full kernel. Costs nothing to enable now.
CONFIG_OF_OVERLAY=y
