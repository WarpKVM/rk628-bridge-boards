+	if (++csi->unlock_ticks >= 5) {
+		csi->unlock_ticks = 0;
+		csi->rk628_reinits++;
+		v4l2_err(sd, "watchdog: wedged (mode %ux%u), chip re-init %u/%u\n",
+			 htotal, vtotal, csi->rk628_reinits, rk628_watchdog_max);
+		mutex_lock(&csi->confctl_mutex);
+		csi->in_full_reinit = true;
+		rk628_full_reinit(sd);
+		csi->in_full_reinit = false;
+		mutex_unlock(&csi->confctl_mutex);
+		schedule_delayed_work(&csi->delayed_work_enable_hotplug,
+				      msecs_to_jiffies(500));
+	}
