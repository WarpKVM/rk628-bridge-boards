+	rk628_i2c_read(csi->rk628, HDMI_RX_SCDC_REGS1, &status);
+	if ((status & 0xfff) >= 0xf00) {
+		csi->unlock_ticks = 0;   /* locked: healthy */
+		csi->rk628_reinits = 0;
+		goto again;
+	}
