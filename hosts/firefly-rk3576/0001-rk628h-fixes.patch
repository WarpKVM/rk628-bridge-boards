+/*
+ * Watchdog: recovers the chip-level wedge in which the mode-detect clock
+ * reads about 4.1x high, the PHY never locks, and HPD control stops taking
+ * effect. Without it only a physical replug cures the wedge.
+ *
+ * It must not trigger on "5V present and unlocked" alone. That is the
+ * ordinary idle state (source asleep, powered off, or not driving video),
+ * and on these boards tx_5v_power_present() can read true with no cable
+ * attached, so a naive watchdog re-initialises the chip every few seconds,
+ * and each re-init is a burst of blocking I2C. So:
+ *
+ *   - it can be turned off (rk628_watchdog=0);
+ *   - it requires the wedge signature (implausible mode-detect totals),
+ *     not merely an unlocked PHY, so an idle input is left alone;
+ *   - attempts are capped with backoff, so it can never loop.
+ */
+static uint rk628_watchdog = 1;
+module_param(rk628_watchdog, uint, 0644);
+static uint rk628_watchdog_max = 3;
+module_param(rk628_watchdog_max, uint, 0644);
+/*
+ * Consecutive I2C failures before the bridge is treated as off the bus and
+ * recovered through the reset GPIO. High enough that a transient NAK never
+ * trips it; low enough that a wedged chip is caught within one tick.
+ */
+static uint rk628_i2c_err_max = 20;
+module_param(rk628_i2c_err_max, uint, 0644);
+
+static int rk628_csi_power_off(struct rk628_csi *csi);
+
+static void rk628_watchdog_work(struct work_struct *work)
+{
+	struct rk628_csi *csi = container_of(to_delayed_work(work),
+					     struct rk628_csi, rk628_watchdog_work_d);
+	struct v4l2_subdev *sd = &csi->sd;
+	u32 status = 0, htotal = 0, vtotal = 0;
+	bool wedged;
+
+	if (!rk628_watchdog || csi->in_full_reinit)
+		goto again;
+
+	/*
+	 * Bus-level recovery, checked before anything that needs I2C.
+	 *
+	 * The bridge can drop off the I2C bus completely, every access
+	 * returning -ETIMEDOUT; replugging HDMI on a powered board does it.
+	 * Once it happens nothing downstream works: EDID cannot be served, so
+	 * the source falls back or loses the display, and the check below is
+	 * blind because its own reads fail.
+	 *
+	 * Only a reset-GPIO cycle recovers it, and that path touches no I2C,
+	 * which is why it works here. The vendor driver has no equivalent:
+	 * reset and enable are sequenced once at probe and never again.
+	 */
+	if (atomic_read(&csi->rk628->i2c_errors) >= rk628_i2c_err_max) {
+		if (csi->rk628_i2c_recoveries >= rk628_watchdog_max) {
+			v4l2_err(sd, "i2c wedged, recovery limit reached; giving up\n");
+			goto again;
+		}
+		csi->rk628_i2c_recoveries++;
+		v4l2_err(sd, "i2c wedged (%d consecutive errors), reset-GPIO recovery %u/%u\n",
+			 atomic_read(&csi->rk628->i2c_errors),
+			 csi->rk628_i2c_recoveries, rk628_watchdog_max);
+
+		csi->in_full_reinit = true;
+		rk628_csi_power_off(csi);
+		usleep_range(20000, 21000);
+		rk628_csi_power_on(csi);
+		atomic_set(&csi->rk628->i2c_errors, 0);
+		csi->in_full_reinit = false;
+
+		/* The chip came up blank: re-run the full init, which restores
+		 * the EDID from the stored copy and re-asserts HPD.
+		 */
+		rk628_full_reinit(sd);
+		csi->unlock_ticks = 0;
+		goto again;
+	}
+
+	if (csi->rk628_reinits >= rk628_watchdog_max)
+		goto again; /* gave up; a real replug path will reset this */
+	if (!tx_5v_power_present(sd)) {
+		csi->unlock_ticks = 0;
+		goto again;
+	}
