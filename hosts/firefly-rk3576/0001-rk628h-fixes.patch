-	if (ret < 0)
+	if (ret < 0) {
+		atomic_inc(&rk628->i2c_errors);	/* see struct rk628 */
 		dev_err(rk628->dev,
 			"%s: i2c err reg=0x%x, val=0x%x, ret=%d\n", __func__, reg, val, ret);
+	} else {
+		atomic_set(&rk628->i2c_errors, 0);
+	}
 
 	return ret;
 }
@@ -311,9 +315,16 @@ int rk628_media_i2c_read(struct rk628 *rk628, u32 reg, u32 *val)
 	} else {
 		ret = regmap_read(rk628->regmap[region], reg, val);
 	}
-	if (ret < 0)
+	/* Count consecutive failures so the watchdog can spot a bridge that
+	 * has fallen off the bus entirely. See struct rk628.
+	 */
+	if (ret < 0) {
+		atomic_inc(&rk628->i2c_errors);
 		dev_err(rk628->dev,
 			"%s: i2c err reg=0x%x, val=0x%x ret=%d\n", __func__, reg, *val, ret);
+	} else {
+		atomic_set(&rk628->i2c_errors, 0);
+	}
 
