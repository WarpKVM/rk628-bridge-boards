+/*
+ * Full chip recovery, modeled on the resume path: hardware reset via the
+ * reset GPIO, then CRU, clock and controller re-init, and the EDID
+ * restored from the stored copy (the chip reset wipes EDID RAM).
+ */
+static void rk628_full_reinit(struct v4l2_subdev *sd)
+{
+	struct rk628_csi *csi = to_csi(sd);
+
+	/*
+	 * Snapshot the EDID before re-init. rk628_csi_initial() applies the
+	 * driver's built-in default through s_edid, which overwrites the
+	 * saved copy, so restoring from it afterwards would re-apply the
+	 * default and discard whatever EDID userspace had set.
+	 */
+	u8 saved[sizeof(csi->edid_copy)];
+	u8 saved_blocks = csi->edid_copy_blocks;
+	bool saved_valid = csi->edid_blk0_valid;
+
+	if (saved_valid)
+		memcpy(saved, csi->edid_copy, sizeof(saved));
+
+	disable_irq(csi->plugin_irq);
+	disable_irq(csi->hdmirx_irq);
+	rk628_csi_power_on(csi);
+	rk628_cru_initialize(csi->rk628);
+	rk628_clk_set_rate(csi->rk628, CGU_CLK_CPLL, CPLL_REF_CLK);
+	rk628_csi_initial(sd);
+	if (saved_valid) {
+		struct v4l2_subdev_edid e = {
+			.pad = 0,
+			.start_block = 0,
+			.blocks = saved_blocks,
+			.edid = saved,
+		};
+		rk628_csi_s_edid(sd, &e);
+	}
+	enable_irq(csi->plugin_irq);
+	enable_irq(csi->hdmirx_irq);
