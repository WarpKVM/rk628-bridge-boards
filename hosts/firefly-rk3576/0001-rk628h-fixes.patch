+/* Parse the preferred (first) DTD out of the stored EDID block 0.
+ * Returns true and fills *t on success. */
+static bool rk628_edid_preferred_timing(struct rk628_csi *csi,
+					struct v4l2_dv_timings *t)
+{
+	const u8 *d;
+	u32 pclk10k, hact, hbl, vact, vbl, hfp, hsw, vfp, vsw;
+
+	if (!csi->edid_blk0_valid)
+		return false;
+	d = &csi->edid_copy[54];
+	pclk10k = d[0] | (d[1] << 8);
+	if (pclk10k < 2500) /* not a detailed timing descriptor */
+		return false;
+	hact = d[2] | ((d[4] >> 4) << 8);
+	hbl = d[3] | ((d[4] & 0xf) << 8);
+	vact = d[5] | ((d[7] >> 4) << 8);
+	vbl = d[6] | ((d[7] & 0xf) << 8);
+	hfp = d[8] | (((d[11] >> 6) & 3) << 8);
+	hsw = d[9] | (((d[11] >> 4) & 3) << 8);
+	vfp = (d[10] >> 4) | (((d[11] >> 2) & 3) << 4);
+	vsw = (d[10] & 0xf) | ((d[11] & 3) << 4);
+	if (!hact || !vact || hbl < hfp + hsw || vbl < vfp + vsw)
+		return false;
+
+	memset(t, 0, sizeof(*t));
+	t->type = V4L2_DV_BT_656_1120;
+	t->bt.interlaced = V4L2_DV_PROGRESSIVE;
+	t->bt.width = hact;
+	t->bt.height = vact;
+	t->bt.hfrontporch = hfp;
+	t->bt.hsync = hsw;
+	t->bt.hbackporch = hbl - hfp - hsw;
+	t->bt.vfrontporch = vfp;
+	t->bt.vsync = vsw;
+	t->bt.vbackporch = vbl - vfp - vsw;
+	t->bt.pixelclock = (u64)pclk10k * 10000;
+	return true;
+}
